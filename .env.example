# ==========================================
# Agent Gateway (Mesh) 统一环境配置文件示例
# 复制此文件为 .env 即可生效：cp .env.example .env
# 各命令行参数仍具有最高优先级（如 --addr 会覆盖 MESH_SERVER_ADDR）
# ==========================================

# ------------------------------------------
# 1. 网关服务端配置 (Gateway Server)
# ------------------------------------------
# HTTPS / mTLS 主通信监听地址（默认 127.0.0.1:8443）
MESH_SERVER_ADDR=127.0.0.1:18443

# HTTP 拒绝监听器（默认关闭；开启也返回426，管理必须使用HTTPS）
MESH_HTTP_ADDR=

# 网关持久化数据存储目录（默认 ./gateway-data）
MESH_DATA_DIR=./gateway-data-main

# 服务端证书 SAN 域名与 IP 白名单（逗号分隔，局域网/多机必填）
MESH_HOSTS=127.0.0.1,localhost

# WebUI 管理员密码（未配置时随机生成并写入私有 admin.password，不输出日志）
# MESH_ADMIN_PASSWORD=

# 启动时自动生成的配对邀请码数量与有效时长
# MESH_INVITATIONS=0
# MESH_INVITE_TTL=15m

# ------------------------------------------
# 2. 节点客户端配置 (Worker Node)
# ------------------------------------------
# 节点数据与凭据目录
MESH_NODE_DIR=./test-local-node

# 节点配置文件路径（由 mesh pair 写入，默认 ./node/node.json）
MESH_NODE_CONFIG=./test-local-node/node.json

# ------------------------------------------
# 3. 远端连接与配对配置 (Pair & Remote)
# ------------------------------------------
# 目标网关基础地址
MESH_SERVER_URL=https://127.0.0.1:18443

# 信任的网关根证书路径
MESH_CA_FILE=./gateway-data-main/ca.crt

# 一次性配对邀请 Token（运行 mesh pair 时可选）
# MESH_PAIR_TOKEN=

# ------------------------------------------
# 4. 操作员与 MCP 配置 (Operator & MCP)
# ------------------------------------------
# 操作员 Token（用于 mesh mcp、mesh task 等）
# MESH_OPERATOR_TOKEN=

# ------------------------------------------
# 5. 全局日志配置 (Global Logging)
# ------------------------------------------
# 日志级别: debug, info, warn, error（默认 info）
MESH_LOG_LEVEL=info
